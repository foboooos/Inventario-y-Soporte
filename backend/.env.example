PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_DATABASE=backend
# Define un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Déjalo en true solo durante el desarrollo inicial.
DB_SYNCHRONIZE=false

# Aplica migraciones pendientes al arrancar. En una base creada con synchronize
# ejecuta primero `npm run migration:baseline`.
DB_MIGRATIONS_RUN=true
