POSTGRES_USER=postgres
# Completa con una contraseña aleatoria antes de iniciar Compose. No reutilizar en producción.
POSTGRES_PASSWORD=
POSTGRES_DB=backend

# Credenciales locales de pgAdmin; completa ambos valores antes de iniciar Compose.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Orígenes permitidos por CORS separados por coma. Vacío en desarrollo.
# En producción, si queda vacío, CORS queda deshabilitado (el frontend se sirve en el mismo origen).
CORS_ORIGIN=

# Define un secreto aleatorio de al menos 32 caracteres antes de iniciar.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Contraseña inicial del administrador base (p. ej. el RUT sin puntos). Solo se usa al crearlo.
SYS_ADMIN_PASSWORD=
# Identidad del administrador base. El nombre es obligatorio; RUT y email tienen valores por defecto.
SYS_ADMIN_RUT=12.345.678-9
SYS_ADMIN_NOMBRE=
SYS_ADMIN_EMAIL=miguel.ramirez@davincicoquimbo.cl
