POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-development
POSTGRES_DB=backend

DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Orígenes permitidos por CORS separados por coma. Vacío en desarrollo.
# En producción, si queda vacío, CORS queda deshabilitado (el frontend se sirve en el mismo origen).
CORS_ORIGIN=

# Define un secreto aleatorio de al menos 32 caracteres antes de iniciar.
JWT_SECRET=
JWT_EXPIRES_IN=1d
